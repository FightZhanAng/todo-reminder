{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": false,
    "outDir": ".tmp-test",
    "rootDir": "."
  },
  "include": [
    "src/shared/**/*.ts",
    "src/main/store.ts",
    "src/main/scheduler.ts",
    "src/main/notices.ts",
    "scripts/core-test.ts"
  ]
}
